{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": [],
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      // Both published archives carry this same curated declaration; the build
      // proves it with `verifySameDeclarations` before the compiler runs.
      "@kadre/host": ["./build/kadre-host-package/js/index.d.ts"]
    }
  },
  "include": ["src"]
}
